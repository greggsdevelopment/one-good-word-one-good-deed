{
  "name": "RSVP Notification Email",
  "description": "Sends a Gmail notification to the team whenever a new EventRSVP is submitted for A Night For Drayke",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "EventRSVP"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "rsvp_notification_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_notification": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendRSVPNotification",
            "args": {
              "rsvp_id": "${ .trigger.data.id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send RSVP notification",
            "description": "Email the team about the new RSVP for A Night For Drayke"
          }
        }
      }
    ]
  }
}