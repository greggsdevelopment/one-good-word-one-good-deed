{
  "name": "Contact Message Notification Email",
  "description": "Sends a Gmail notification to the team whenever a new ContactMessage is created (contact form message or prayer request)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ContactMessage"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "contact_message_notification_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_notification": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendRecordNotification",
            "args": {
              "entity": "ContactMessage",
              "record_id": "${ .trigger.data.id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send contact message notification",
            "description": "Email the team about the new contact form message or prayer request"
          }
        }
      }
    ]
  }
}
