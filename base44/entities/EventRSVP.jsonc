{
  "name": "EventRSVP",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "The id of the Event this RSVP belongs to"
    },
    "event_title": {
      "type": "string",
      "description": "Snapshot of the event title at submit time"
    },
    "full_name": {
      "type": "string",
      "description": "Full name of the person RSVPing"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "adults_attending": {
      "type": "number",
      "description": "Number of adults attending"
    },
    "children_attending": {
      "type": "number",
      "description": "Number of children attending"
    },
    "message": {
      "type": "string",
      "description": "Optional message from the guest"
    },
    "checked_in": {
      "type": "boolean",
      "default": false,
      "description": "Whether the guest has checked in at the event"
    },
    "checked_in_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the guest was checked in"
    },
    "admin_notes": {
      "type": "string",
      "description": "Admin-only notes about this RSVP"
    },
    "notification_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp set by the backend after the notification email is sent"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
