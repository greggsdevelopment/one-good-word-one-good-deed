{
  "description": "Sends a Gmail notification to the team whenever a school submits a new program booking request",
  "name": "Booking Notification Email",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "BookingRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "booking_notification_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_notification": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendBookingNotification",
            "args": {
              "booking": {
                "school_name": "${ .trigger.data.school_name }",
                "district": "${ .trigger.data.district }",
                "school_type": "${ .trigger.data.school_type }",
                "grade_band": "${ .trigger.data.grade_band }",
                "num_students": "${ .trigger.data.num_students }",
                "package_type": "${ .trigger.data.package_type }",
                "target_term": "${ .trigger.data.target_term }",
                "preferred_date": "${ .trigger.data.preferred_date }",
                "date_window_1": "${ .trigger.data.date_window_1 }",
                "date_window_2": "${ .trigger.data.date_window_2 }",
                "date_window_3": "${ .trigger.data.date_window_3 }",
                "payment_route": "${ .trigger.data.payment_route }",
                "po_number": "${ .trigger.data.po_number }",
                "quoted_total": "${ .trigger.data.quoted_total }",
                "contact_name": "${ .trigger.data.contact_name }",
                "contact_role": "${ .trigger.data.contact_role }",
                "principal_name": "${ .trigger.data.principal_name }",
                "email": "${ .trigger.data.email }",
                "phone": "${ .trigger.data.phone }",
                "message": "${ .trigger.data.message }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send booking notification",
            "description": "Email the team about the new school booking request"
          }
        }
      }
    ]
  }
}