{
  "name": "Pledge",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "First name of the person pledging"
    },
    "last_initial": {
      "type": "string",
      "description": "Last initial only (for privacy)"
    },
    "city": {
      "type": "string",
      "description": "City of the person pledging"
    },
    "pledge_statement": {
      "type": "string",
      "description": "Their personal pledge statement"
    },
    "approved": {
      "type": "boolean",
      "default": false,
      "description": "Whether the pledge has been approved by admin"
    },
    "notification_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp set by the backend after the notification email is sent"
    },
    "submitter_tag": {
      "type": "string",
      "description": "Anonymous tag (from a one-way hash) so viewers can block and we can ban a submitter without storing who they are"
    },
    "hidden_reason": {
      "type": "string",
      "description": "Why an approved pledge was taken down, like reported"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time",
      "description": "When it was last reported"
    }
  },
  "required": [
    "first_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.approved": true
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "allowPublicRead": true
}
