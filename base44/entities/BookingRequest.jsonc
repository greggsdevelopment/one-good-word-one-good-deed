{
  "name": "BookingRequest",
  "type": "object",
  "properties": {
    "school_name": {
      "type": "string",
      "description": "Name of the school"
    },
    "contact_name": {
      "type": "string",
      "description": "Contact person's name"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "preferred_date": {
      "type": "string",
      "format": "date",
      "description": "Preferred visit date"
    },
    "num_students": {
      "type": "number",
      "description": "Estimated number of students"
    },
    "message": {
      "type": "string",
      "description": "Additional notes or questions"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled"
      ],
      "default": "pending",
      "description": "Booking status"
    }
  },
  "required": [
    "school_name",
    "contact_name",
    "email"
  ],
  "allowPublicCreate": true,
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}