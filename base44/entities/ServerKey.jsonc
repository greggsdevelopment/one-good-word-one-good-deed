{
  "name": "ServerKey",
  "type": "object",
  "description": "Random server-side keys created by backend functions. Never readable outside the admin role.",
  "properties": {
    "name": {
      "type": "string",
      "description": "What the key is for"
    },
    "value": {
      "type": "string",
      "description": "Random secret"
    }
  },
  "required": [
    "name",
    "value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
