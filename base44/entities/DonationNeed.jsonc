{
  "name": "DonationNeed",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "What we accept, as donors see it, e.g. Backpacks or Socks and underwear (kids sizes)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Backpacks",
        "School supplies",
        "Clothing",
        "Shoes",
        "Coats and winter gear",
        "Hygiene and personal care",
        "Baby and toddler",
        "Blankets and bedding",
        "Books",
        "Toys and games",
        "Other"
      ],
      "default": "School supplies",
      "description": "Category, used to group the list and match inventory"
    },
    "details": {
      "type": "string",
      "description": "Donor-facing rules for this item, e.g. Kids and teen sizes, zippers must work"
    },
    "accepted_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "New",
          "Like new",
          "Gently used"
        ]
      },
      "description": "Which conditions we take. Anything else is refused by the server."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "paused",
        "full"
      ],
      "default": "open",
      "description": "open shows on the form; paused hides it; full hides it and tells donors we are covered"
    },
    "max_per_donation": {
      "type": "number",
      "description": "Most units one offer may include. Blank means no cap beyond the global limit."
    },
    "target_quantity": {
      "type": "number",
      "description": "How many we want on hand, for the admin to decide when to mark it full"
    },
    "inventory_item_id": {
      "type": "string",
      "description": "InventoryItem this need feeds when donations are received"
    },
    "sort_order": {
      "type": "number",
      "default": 100,
      "description": "Lower numbers show first"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "allowPublicRead": true,
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
