{
  "name": "DonationSettings",
  "type": "object",
  "properties": {
    "item_donations_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master switch for the item donation form on /donate. The submitItemDonation function refuses new offers when this is false."
    },
    "pickup_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether donors may request a pickup. When false only drop-off is offered."
    },
    "money_donations_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the GoFundMe money section shows on /donate"
    },
    "pickup_radius_miles": {
      "type": "number",
      "default": 50,
      "description": "Straight-line pickup radius in miles, measured from Westland, MI"
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What we need most right now, shown on /donate"
    },
    "dropoff_instructions": {
      "type": "string",
      "description": "What a donor sees when they choose drop-off"
    },
    "closed_message": {
      "type": "string",
      "description": "Shown on /donate when donations are turned off"
    },
    "gofundme_url": {
      "type": "string",
      "description": "Link for money donations"
    }
  },
  "required": [],
  "allowPublicRead": true,
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
