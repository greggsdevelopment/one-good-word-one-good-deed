{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Unique order reference number"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer full name"
    },
    "email": {
      "type": "string",
      "description": "Customer email"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "state": {
      "type": "string",
      "description": "State"
    },
    "zip": {
      "type": "string",
      "description": "ZIP code"
    },
    "items": {
      "type": "string",
      "description": "JSON string of cart items"
    },
    "total": {
      "type": "number",
      "description": "Order total in USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "shipped",
        "delivered"
      ],
      "default": "pending",
      "description": "Order status"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe Checkout Session id. Written by the stripeWebhook function and used to make sure one payment never creates two orders."
    },
    "stripe_payment_intent": {
      "type": "string",
      "description": "Stripe PaymentIntent id, for refunds and reconciliation"
    },
    "payment_status": {
      "type": "string",
      "description": "Payment status reported by Stripe, e.g. paid"
    },
    "notification_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp set by the backend after the notification email is sent"
    },
    "carrier": {
      "type": "string",
      "description": "Shipping carrier, e.g. USPS"
    },
    "tracking_number": {
      "type": "string",
      "description": "Tracking number once shipped"
    },
    "shipped_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the order was marked shipped"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes, never shown to the public"
    }
  },
  "required": [
    "customer_name",
    "email",
    "order_number"
  ],
  "allowPublicCreate": true,
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
