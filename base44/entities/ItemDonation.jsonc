{
  "name": "ItemDonation",
  "type": "object",
  "properties": {
    "donor_name": {
      "type": "string",
      "description": "Donor full name"
    },
    "email": {
      "type": "string",
      "description": "Donor email"
    },
    "phone": {
      "type": "string",
      "description": "Donor phone"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": { "type": "string" },
          "description": { "type": "string" },
          "quantity": { "type": "number" },
          "condition": { "type": "string" }
        }
      },
      "description": "Line items the donor is offering"
    },
    "delivery_method": {
      "type": "string",
      "enum": [
        "pickup",
        "dropoff"
      ],
      "description": "Whether we pick up or the donor drops off"
    },
    "address_line": {
      "type": "string",
      "description": "Pickup street address"
    },
    "city": {
      "type": "string",
      "description": "Pickup city"
    },
    "state": {
      "type": "string",
      "description": "Pickup state"
    },
    "zip": {
      "type": "string",
      "description": "Pickup ZIP code"
    },
    "matched_address": {
      "type": "string",
      "description": "Address as matched by the geocoder"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "distance_miles": {
      "type": "number",
      "description": "Straight-line miles from Westland, MI, computed by the server"
    },
    "pickup_window": {
      "type": "string",
      "description": "When the donor said pickup works"
    },
    "notes": {
      "type": "string",
      "description": "Anything else the donor said"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "scheduled",
        "received",
        "declined",
        "cancelled"
      ],
      "default": "new",
      "description": "Where this offer stands"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "Agreed pickup or drop-off time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the items were logged into inventory"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes, never shown to the donor"
    },
    "notification_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set by the backend after the notification email is sent"
    }
  },
  "required": [
    "donor_name",
    "email",
    "delivery_method"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
