{
  "name": "Invoice",
  "type": "object",
  "description": "Money a school owes us.",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "School"
    },
    "booking_id": {
      "type": "string",
      "description": "Booking it bills"
    },
    "number": {
      "type": "string",
      "description": "Invoice number, like OGW-2026-0001"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Date issued"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Date due"
    },
    "line_items": {
      "type": "array",
      "description": "What is being billed",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          }
        }
      }
    },
    "discount": {
      "type": "number",
      "description": "Amount off the subtotal",
      "default": 0
    },
    "total": {
      "type": "number",
      "description": "Amount due (subtotal minus discount)",
      "default": 0
    },
    "po_number": {
      "type": "string",
      "description": "School purchase order number"
    },
    "status": {
      "type": "string",
      "description": "draft = only we see it; sent; paid; void",
      "enum": [
        "draft",
        "sent",
        "paid",
        "void"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string",
      "description": "Printed on the invoice"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When it was shared with the school"
    }
  },
  "required": [
    "school_id",
    "number"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
