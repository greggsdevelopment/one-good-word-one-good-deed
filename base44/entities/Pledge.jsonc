{
  "name": "Pledge",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "last_initial": {
      "type": "string",
      "description": "Last initial only (privacy)"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "pledge_statement": {
      "type": "string",
      "description": "Their personal pledge statement"
    }
  },
  "required": [
    "first_name",
    "last_initial",
    "pledge_statement"
  ],
  "allowPublicCreate": true,
  "allowPublicRead": true
}