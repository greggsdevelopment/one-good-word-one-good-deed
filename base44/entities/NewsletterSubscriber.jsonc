{
  "name": "NewsletterSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Subscriber email address"
    },
    "notification_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp set by the backend after the notification email is sent"
    }
  },
  "required": [
    "email"
  ],
  "allowPublicCreate": true,
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
